{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom/vitest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["../../supabase/types/*"]
    }
  },
  "include": ["src", "../../supabase/types", "vite.config.ts", "vitest.config.ts", "pwa-assets.config.ts"]
}
